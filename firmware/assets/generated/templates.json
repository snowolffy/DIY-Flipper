{
  "format": "flipper-ui-templates/1",
  "about": "Screen templates from Flipper UI Studio. Fixed 128x160 screen; zones are absolute integer pixel rectangles (x, y, w, h), drawn in list order (later = on top). No stretching or relative sizing.",
  "screen": {
    "w": 128,
    "h": 160
  },
  "centering": "When centering leaves an odd pixel (an odd-width item in an even-width space, or the other way round), the item goes toward the left / top: pos = start + floor((span - size) / 2). The Studio's snapping uses the same rule.",
  "roles": {
    "status": "status bar; a template without one is full-screen",
    "text": "text area; pad = inner padding",
    "list": "repeating rows; rowH, iconSize, iconX/iconY = icon offset inside a row, textX = label x inside the zone, scrollbarW; visible rows = floor(h / rowH)",
    "detail": "label/value rows; rowH, valueX = value column x inside the zone; rows = floor(h / rowH)",
    "carousel": "single-row character picker; selW = width of the selection box, centered by the rule above, inset 2 px top and bottom",
    "icon": "fixed icon slot",
    "image": "fixed image slot",
    "free": "guide region with no meaning"
  },
