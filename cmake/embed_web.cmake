# embed_web.cmake - writes OUT (a .cpp) holding every file under DIR as a byte array (see web_assets.h).
# cmake -DDIR=simulator/web -DOUT=build/web_assets.cpp -P cmake/embed_web.cmake
file(GLOB_RECURSE files RELATIVE ${DIR} ${DIR}/*)
list(SORT files)
set(body "// generated by cmake/embed_web.cmake - do not edit\n#include \"cli/web_assets.h\"\n\nnamespace simcli {\n\n")
set(table "")
set(i 0)
foreach(f ${files})
  if(f MATCHES "LICENSE")
    continue()
  endif()
  file(READ ${DIR}/${f} hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR size "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "static const unsigned char f${i}[] = {${bytes}0};\n")
  if(f MATCHES "\\.html$")
    set(type "text/html; charset=utf-8")
  elseif(f MATCHES "\\.css$")
    set(type "text/css; charset=utf-8")
  elseif(f MATCHES "\\.js$")
    set(type "text/javascript; charset=utf-8")
  elseif(f MATCHES "\\.woff2$")
    set(type "font/woff2")
  elseif(f MATCHES "\\.svg$")
    set(type "image/svg+xml")
  else()
    set(type "application/octet-stream")
  endif()
  string(APPEND table "    {\"${f}\", \"${type}\", f${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "\nconst WebFile kWebFiles[] = {\n${table}};\nconst size_t kWebFileCount = ${i};\n\n}  // namespace simcli\n")
file(WRITE ${OUT}.tmp "${body}")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
