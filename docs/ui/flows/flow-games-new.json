{
  "format": "flipper-ui-flow/2",
  "schema": {
    "about": "A UI flow of the DIY Flipper (128x160 screen) as a state machine. states = screens and internal decisions; transitions = what moves from one state to another. Import accepts this file back (Flows > Import). x / y are optional: states without them are laid out on a grid.",
    "state": {
      "id": "unique string",
      "kind": "screen | internal (a firmware decision, no screen)",
      "title": "string",
      "note": "string",
      "inputMode": "screens: normal | list | text (how the firmware treats the buttons on that screen)",
      "start": "true on the one state the flow starts at",
      "end": "true on a screen that is meant to have no way out",
      "mockup": "screens: { id, name, file, template } of the linked asset (export only; import uses mockup.id)",
      "x": "number, optional",
      "y": "number, optional"
    },
    "transition": {
      "id": "unique string",
      "from": "state id",
      "to": "state id",
      "name": "free text label (event = same, for older readers)",
      "note": "string",
      "trigger": "null, or { type: 'button', held: null|button, button, gesture } | { type: 'timer', ms } | { type: 'system', event: systemEvents[].id }",
      "transition": "{ type: cut | slide | push | fade, dir: left|right|up|down (slide/push: where things move), ms, easing: linear|ease-in|ease-out|ease-in-out }"
    },
    "buttons": "ok, cancel, left (<), right (>), power. There is no D-pad, no up/down, no touch.",
    "gestures": "tap: on press, or on release (before hold_ms) when the same button also has a hold/repeat transition on that screen; hold: once at hold_ms; repeat: at hold_ms, then again faster and faster; release: on release, any duration. held: that button must already be down; when such a combo fires, the held button's own tap/release is skipped.",
    "input": {
      "hold_ms": 500,
      "repeat_start_interval_ms": 200,
      "repeat_accel": 0.8,
      "repeat_min_interval_ms": 40,
      "normal": "hold OK + < / > scrolls up / down",
      "list": "< / > move the selection up / down (no need to hold OK); hold Cancel on a list item deletes it",
      "text": "hold OK switches upper / lower case; hold Cancel cancels the input"
    }
  },
